# Copy this file to .env and fill in your key.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# Optional overrides
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# Voices offered by the on-screen selector.
# Female options: Aoede, Kore, Leda, Zephyr · male options: Charon, Orus, Puck, Fenrir
# (accent follows languageCode en-GB, set in the app)
GEMINI_VOICE_FEMALE=Aoede
GEMINI_VOICE_MALE=Charon
PORT=8787

# VIKI escape-room team roster proxy (optional). Ask the GM for the secret.
# VIKI_GM_SECRET=your-gm-secret
# VIKI_TEAMS_URL=https://viki-escape-room.replit.app/api/viki/teams/visible
# VIKI_INTEGRATION_SECRET=your-integration-secret
# VIKI_COMPLETE_SECRET=module-complete-secret
# VIKI_COMPLETE_URL=https://viki-escape-room.replit.app/api/viki/modules/dail/complete
